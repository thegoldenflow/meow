{
  "name": "@meow/api",
  "version": "0.0.1",
  "description": "Meow API - Backend service for 背单词 + 云养猫 app",
  "author": "",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:check": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:e2e:pg": "jest --config ./test/jest-pg-e2e.json",
    "test:e2e:h1": "jest --config ./test/jest-h1-e2e.json",
    "test:e2e:h3": "jest --config ./test/jest-h3-e2e.json",
    "db:migrate": "ts-node src/infrastructure/postgres/migrate.ts up",
    "db:migrate:down": "ts-node src/infrastructure/postgres/migrate.ts down",
    "db:migrate:status": "ts-node src/infrastructure/postgres/migrate.ts status",
    "db:seed": "ts-node src/infrastructure/postgres/seed/dev-seed.ts",
    "db:reset": "ts-node src/infrastructure/postgres/migrate.ts down && ts-node src/infrastructure/postgres/migrate.ts up && ts-node src/infrastructure/postgres/seed/dev-seed.ts",
    "db:import": "ts-node scripts/db/import-json.ts",
    "db:import:validate": "ts-node scripts/db/import-json.ts --validate",
    "db:backup": "ts-node scripts/db/backup.ts",
    "db:restore": "ts-node scripts/db/restore.ts",
    "load:auth-guest": "ts-node scripts/load-test-auth-guest.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^16.4.5",
    "jsonwebtoken": "^9.0.3",
    "p-limit": "^4.0.0",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.3.1",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^2.0.12",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.13.0",
    "jest": "^29.5.0",
    "prettier": "^3.9.10",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3",
    "typescript-eslint": "^8.71.1"
  },
  "jest": {
    "setupFiles": [
      "../test/jest-env-setup.ts"
    ],
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}

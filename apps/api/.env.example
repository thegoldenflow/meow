# ========== Meow API Environment Variables ==========

# Server
PORT=3000
NODE_ENV=development
CORS_ORIGIN=*

# PostgreSQL (needed from A2 onward)
# Replace YOUR_PASSWORD_HERE with your actual PostgreSQL password
DATABASE_URL=postgresql://postgres:jason123@localhost:5432/meow_dev

# Persistence backend: 'pg' (default) or 'json' (legacy fallback)
PERSISTENCE_BACKEND=pg

# Maintenance mode: set to 'true' to reject writes with maintenance status
# MAINTENANCE_MODE=false

# ========== Auth (需求 23 / Phase A2+) ==========

# JWT signing secret (HS256). Min 16 chars. Server refuses to start without it.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string_min_16_chars

# AUTH_ENFORCE controls whether AuthGuard requires a valid Bearer token.
#   'true':  required; missing/invalid token → 401
#   anything else (default): permissive — token honored if present, else
#                            falls back to DEV_FALLBACK_USER_ID. Lets old
#                            clients keep working during Phase A~D rollout.
# Phase E1 flips this to 'true' in staging, then prod. main.ts asserts
# NODE_ENV=production ⇒ AUTH_ENFORCE=true.
AUTH_ENFORCE=false

# Permissive-mode fallback user (only used when AUTH_ENFORCE != 'true').
# Defaults to 'dev-user-001' if unset.
DEV_FALLBACK_USER_ID=dev-user-001

# Legacy DevStore persistence (used when PERSISTENCE_BACKEND=json)
# DEV_STORE_PERSIST_DIR=./data
# DEV_STORE_PERSIST_FILENAME=dev-store-state.json

# ----- PR-D Option A: Tencent COS public-read base -----
# Format: https://<bucket>.cos.<region>.myqcloud.com (no trailing slash)
#
# AUDIO_CDN_ORIGIN — required by apps/api/scripts/ingest-audio-assets.ts.
#   Missing → script exits with code 2 (R4 P1#2 R2: fail-fast since /cdn
#   static route is removed; legacy 10.0.2.2:3000 fallback would write
#   forever-404 URLs into PG audio_assets.url).
#
# PRONUNCIATION_CDN_ORIGIN — required by NestJS pronunciation.controller.ts.
#   Missing → 500 InternalServerErrorException (R4 P1-3: server config
#   error, not 404 — 404 would mislead clients into thinking the requested
#   word is missing from the corpus).
#
# Same value typically; split for future multi-bucket flexibility (PR-E).
AUDIO_CDN_ORIGIN=https://your-bucket.cos.ap-shanghai.myqcloud.com
PRONUNCIATION_CDN_ORIGIN=https://your-bucket.cos.ap-shanghai.myqcloud.com

# ========== 需求 24: Audio Access Mode 切换 ==========
#
# AUDIO_ACCESS_MODE — 决定 audio metadata 接口返回的 meta.url 指向何处。
#   - 'backend_proxy_stream' (默认, 2026-05-22 起): meta.url 是
#       ${API_PUBLIC_BASE}/audio/stream/:audio_id，App 拉服务端，服务端
#       用 COS internal endpoint 读流转发。COS 外网下行流量降为 0，服务
#       器代付公网下行。生产服务器必须在腾讯云 VPC 同地域 CVM。
#   - 'backend_issued_cos_url' (兼容模式 / 回滚开关): meta.url 是 COS
#       公网 URL，App 直接 GET COS。COS 外网读已关闭，此模式仅在腾讯
#       云控制台重新打开外网读后才能用。
#
# /api/v1/pronunciation/:word 也按本开关切换：cos 模式 302 → COS public，
# stream 模式 stream WAV 二进制返回。
#
# 启动 fail-fast: stream 模式下若缺 COS_REGION/BUCKET/SECRET_ID/SECRET_KEY
# 任一个，进程拒绝启动（见 audio-access-url.service.ts
# assertAudioAccessModeReady，main.ts 调用）。
#
AUDIO_ACCESS_MODE=backend_proxy_stream

# API_PUBLIC_BASE — backend_proxy_stream 模式下，meta.url 的前缀。
# 必须包含到 /api/v1，且与 mobile apps 的 apiV1Base (dart-define API_BASE)
# 对齐。本地调试常用 http://10.0.2.2:3000/api/v1 （Android 模拟器访问宿
# 主机的别名）。生产是 https://api.<your-domain>/api/v1。
# 若未设置，service 退化为相对路径 '/api/v1'（仅适合同源场景，App 跨
# 域调用必须显式设置）。
# API_PUBLIC_BASE=http://10.0.2.2:3000/api/v1

# ----- 腾讯云 COS 服务端读取（backend_proxy_stream 模式下必填） -----
#
# 仅 server-side：这些凭证**绝不**外泄给 App。和 scripts/content_pipeline/.env
# 里 ingest 管线写入用的凭证可以是同一个 secret，也可以独立（只读子账号
# 更安全）。
#
# COS_INTERNAL_ENDPOINT — VPC 内网 endpoint，例如：
#     https://cos-internal.ap-shanghai.tencentcos.cn
# 实际域名以腾讯云官方文档为准（不同 region 不同；自建机房不在 VPC 内
# 用不了内网）。未配置时 CosStorageService 回落 public endpoint
# https://cos.${COS_REGION}.myqcloud.com（dev 友好，生产应显式配置）。
#
# COS_REGION — 桶所在 region（如 ap-shanghai），与 AUDIO_CDN_ORIGIN 一致。
# COS_BUCKET — 桶名（如 meow-app-1430708523）。
# COS_SECRET_ID / COS_SECRET_KEY — 腾讯云子账号 API 凭证，建议只读权限。
#
# COS_INTERNAL_ENDPOINT=https://cos-internal.ap-shanghai.tencentcos.cn
# COS_REGION=ap-shanghai
# COS_BUCKET=your-bucket
# COS_SECRET_ID=
# COS_SECRET_KEY=

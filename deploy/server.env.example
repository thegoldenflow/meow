# Docker image registry
# TCR_REGISTRY examples:
# - ccr.ccs.tencentyun.com
# - <your-tcr-instance>.tcr.tencentcloudcr.com
TCR_REGISTRY=ccr.ccs.tencentyun.com
TCR_NAMESPACE=miaory
API_IMAGE_TAG=latest

# PostgreSQL
POSTGRES_DB=meow_prod
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_strong_password

# API
CORS_ORIGIN=*
AUDIO_CDN_ORIGIN=https://meow-app-1430708523.cos.ap-shanghai.myqcloud.com
PRONUNCIATION_CDN_ORIGIN=https://meow-app-1430708523.cos.ap-shanghai.myqcloud.com

# ----- 需求 24: Audio Access Mode（生产必填） -----
# 流量路径：App → 本服务 → COS internal endpoint。
# 切回 backend_issued_cos_url 需先在腾讯云控制台重新打开 COS 外网读，否则
# 客户端拉 COS URL 会 403。
AUDIO_ACCESS_MODE=backend_proxy_stream

# 与移动端 apiV1Base（dart-define API_BASE）对齐，含 /api/v1 前缀
API_PUBLIC_BASE=https://api.miaory.chat/api/v1

# ----- 需求 24: 腾讯云 COS internal 读取（stream 模式必填） -----
# internal endpoint 仅同地域 CVM 可达；本服务部署在 ap-shanghai。
COS_INTERNAL_ENDPOINT=https://cos-internal.ap-shanghai.tencentcos.cn
COS_REGION=ap-shanghai
COS_BUCKET=meow-app-1430708523
# 强烈建议用 CAM 只读子账号（cos:GetObject 权限 + 限定 bucket，最小特权）
COS_SECRET_ID=replace_with_readonly_subaccount_id
COS_SECRET_KEY=replace_with_readonly_subaccount_key

# Caddy
CADDY_SITE_ADDRESS=api.miaory.chat, miaory.chat
HTTP_PORT=80
HTTPS_PORT=443
